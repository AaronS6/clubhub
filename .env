DATABASE_URL=file:/home/z/my-project/db/custom.db

# --- Email (Resend) — OPTIONAL -------------------------------------------------
# If RESEND_API_KEY is unset/empty, email sending is a graceful no-op (logs a
# warning in non-production). The app works fine without email configured.
#
# Get a key at https://resend.com/api-keys. Without a verified domain, set
# EMAIL_FROM to "ClubHub <onboarding@resend.dev>" (Resend's sandbox sender —
# only delivers to your account's own verified email). After you verify your
# domain in Resend, set EMAIL_FROM to "ClubHub <noreply@yourdomain.com>".
RESEND_API_KEY=
EMAIL_FROM=ClubHub <onboarding@resend.dev>
NEXTAUTH_URL=http://localhost:3000
