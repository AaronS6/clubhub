// Multi-Club Management Platform — Prisma schema.
//
// LOCAL DEV uses SQLite (matches the file:// DATABASE_URL in .env). The
// schema has NO Postgres-only features (no scalar lists, no @db.* native
// types), so it is portable between SQLite and Postgres.
//
// PRODUCTION uses PostgreSQL (Supabase). The Dockerfile flips the provider
// to "postgresql" with sed before `prisma generate` / `next build`, so the
// generated Prisma client targets Postgres while the committed schema
// stays SQLite-friendly for local dev. See Dockerfile (build stage).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & Auth
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String?
  avatarUrl     String?
  /** Discord-style decorative frame around the avatar (see DecoratedAvatar). */
  avatarDecoration String @default("none")
  bio           String?
  emailVerified Boolean  @default(false)
  notifPrefs    String   @default("{}") // JSON string of notification preferences
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships         ClubMember[]
  joinRequests        JoinRequest[]
  reviewedJoinRequests JoinRequest[] @relation("JoinRequestReviewer")
  serviceHours        ServiceHour[]
  reviewedServiceHours ServiceHour[] @relation("ServiceHourReviewer")
  announcements       Announcement[]
  comments            AnnouncementComment[]
  reactions           AnnouncementReaction[]
  tasksAssigned     Task[]      @relation("TaskAssignee")
  tasksCreated      Task[]      @relation("TaskCreator")
  taskComments      TaskComment[]
  teamMembers       TeamMember[]
  meetingRsvps      MeetingRsvp[]
  meetingsCreated   Meeting[]   @relation("MeetingCreator")
  notifications     Notification[]
  activityLogs      ActivityLog[]
  sessions          Session[]
  conversationMembers ConversationMember[]
  messages          Message[]
  messageReactions  MessageReaction[]
  badgesCreated   Badge[]       @relation("BadgeCreator")
  badgesAwarded    MemberBadge[] @relation("BadgeAwarder")
  receivedBadges   MemberBadge[]
  createdTransactions ClubTransaction[]
  notes             ClubNote[]
  noteHearts        NoteHeart[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime
}

// ---------------------------------------------------------------------------
// Clubs & Membership
// ---------------------------------------------------------------------------

model Club {
  id               String   @id @default(cuid())
  name             String
  description      String?
  logoUrl          String?
  // Cinematic dashboard banner (data URL from upload, or a static path).
  // Rendered edge-to-edge on the dashboard hero card with gradient blending.
  bannerUrl        String?
  // Vertical focal point for the banner's cover crop, 0 (top) … 1 (bottom).
  // Controls which part of the image stays visible on wide/short crops.
  // Null = default center (0.5). Adjusted in the exec banner editor.
  bannerFocalY     Float?
  // Opt-in PUBLIC DIRECTORY listing. When true, the club appears in the
  // public landing page's "Explore clubs" directory and is discoverable by
  // unauthenticated visitors. The public profile by club code stays
  // available either way (the code itself gates discovery — existing
  // convention). Executives toggle this from Members → Club settings.
  isListedPublic   Boolean  @default(false)
  // How new members join. "code" (default) = the classic club code +
  // join password flow. "request" = students send a join request and an
  // executive approves or declines it (JoinRequest rows). Executives toggle
  // this from Members → Club settings. Public profiles + the join dialog
  // adapt their copy/flow to the mode.
  joinMode         String   @default("code") // "code" | "request"
  accentColor      String   @default("#16a34a") // default brandable accent
  clubCode         String   @unique // 6-char human-friendly code
  clubPasswordEnc  String   // AES-256-GCM encrypted join password (reversible for exec display)
  hoursGoal        Float    @default(0) // optional per-club hours goal
  // Exec-set "what the club is working on right now". API-enforced max 280 chars.
  mainGoal         String?
  // Executive Admin Handbook acknowledgment. Set (once) when the creating
  // executive confirms the Executive Admin Handbook popup — the popup is
  // shown exactly ONCE per club lifetime (null = not yet acknowledged).
  handbookAcceptedAt DateTime?
  createdBy         String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  members         ClubMember[]
  serviceHours    ServiceHour[]
  announcements   Announcement[]
  meetings        Meeting[]
  teams           Team[]
  tasks           Task[]
  notifications   Notification[]
  activityLogs    ActivityLog[]
  serviceCategories ServiceCategory[]
  conversations   Conversation[]
  badges          Badge[]
  memberBadges    MemberBadge[]
  transactions    ClubTransaction[]
  notes           ClubNote[]
  noteTags        NoteTag[]
  joinRequests    JoinRequest[]
}

// ── Join requests (joinMode = "request") ────────────────────────────────────
// A student asking to join a club that reviews applicants. Creating a
// request does NOT touch ClubMember — membership is only created when an
// executive approves (review mutation), which keeps every existing
// ClubMember query (status "active" semantics) untouched.

model JoinRequest {
  id              String    @id @default(cuid())
  clubId          String
  userId          String
  // Optional note from the student ("why I want in"), max ~280 chars.
  message         String?
  // "pending" | "approved" | "rejected" | "withdrawn"
  status          String    @default("pending")
  createdAt       DateTime  @default(now())
  reviewedAt      DateTime?
  reviewedByUserId String?

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("JoinRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([clubId, userId]) // one request per user per club
  @@index([clubId, status])
}

model ClubMember {
  id        String   @id @default(cuid())
  clubId    String
  userId    String
  role      String   @default("member") // "member" | "executive"
  status    String   @default("active") // "active" | "removed"
  joinedAt  DateTime @default(now())
  // Personal service-hours goal for THIS member in THIS club (set during the
  // introduction tour or later from the hours view). 0 = no personal goal —
  // the dashboard then falls back to the club-wide goal. Kept per-membership
  // so the same user can have different goals in different clubs.
  personalHoursGoal Float  @default(0)

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
}

model ServiceCategory {
  id        String   @id @default(cuid())
  clubId    String
  name      String
  createdAt DateTime @default(now())

  club         Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  serviceHours ServiceHour[]
}

// ---------------------------------------------------------------------------
// Service Hours
// ---------------------------------------------------------------------------

model ServiceHour {
  id             String   @id @default(cuid())
  clubId         String
  userId         String
  categoryId     String?
  dateOfService  DateTime
  hours          Float
  reasonText     String
  proofFileUrl   String? // deleted after review
  status         String   @default("pending") // pending | approved | rejected
  reviewedBy     String?
  reviewComment  String?
  submittedAt    DateTime @default(now())
  reviewedAt     DateTime?

  club     Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  reviewer User?             @relation("ServiceHourReviewer", fields: [reviewedBy], references: [id])

  @@index([clubId, status])
  @@index([clubId, userId, status])
  @@index([clubId, submittedAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Announcements, Reactions, Comments
// ---------------------------------------------------------------------------

model Announcement {
  id        String   @id @default(cuid())
  clubId    String
  authorId  String
  title     String
  body      String
  isPinned  Boolean  @default(false)
  isUrgent  Boolean  @default(false) // exec-only banner flag — shows app-wide dismissible banner
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club       Club                    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  author     User                    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions  AnnouncementReaction[]
  comments   AnnouncementComment[]

  @@index([clubId, createdAt])
}

model AnnouncementReaction {
  id             String   @id @default(cuid())
  announcementId String
  userId         String
  emoji          String
  createdAt      DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId]) // one reaction per user per announcement (swap emoji on change)
  @@index([announcementId])
}

model AnnouncementComment {
  id             String   @id @default(cuid())
  announcementId String
  authorId       String
  body           String
  createdAt      DateTime @default(now())
  deletedAt      DateTime? // soft delete -> "[comment removed]"

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([announcementId, createdAt])
}

// ---------------------------------------------------------------------------
// Teams & Tasks
// ---------------------------------------------------------------------------

model Team {
  id          String   @id @default(cuid())
  clubId      String
  name        String
  description String?
  // Exec-set team "main idea" — what this team is contributing to the club main goal.
  // API-enforced max 280 chars.
  mainIdea    String?
  createdAt   DateTime @default(now())

  club     Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  members  TeamMember[]
  tasks    Task[]
  meetings Meeting[]

  @@index([clubId])
}

model TeamMember {
  id      String   @id @default(cuid())
  teamId  String
  userId  String
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Task {
  id              String   @id @default(cuid())
  clubId          String
  teamId          String?
  title            String
  description      String?
  assignedToUserId String?
  dueDate         DateTime?
  status          String   @default("not_started") // not_started | in_progress | done
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String

  club        Club       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team        Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignee    User?      @relation("TaskAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  creator     User       @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  subtasks    Subtask[]
  comments    TaskComment[]

  @@index([clubId, status])
  @@index([clubId, assignedToUserId])
  @@index([assignedToUserId])
  @@index([teamId])
}

model Subtask {
  id        String   @id @default(cuid())
  taskId    String
  title     String
  isDone    Boolean  @default(false)
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

// ---------------------------------------------------------------------------
// Meetings & RSVPs
// ---------------------------------------------------------------------------

model Meeting {
  id             String   @id @default(cuid())
  clubId         String
  teamId         String?
  title          String
  description    String?
  location       String
  startTime      DateTime
  endTime        DateTime
  isRecurring    Boolean  @default(false)
  recurrenceRule String? // e.g. "weekly" | "biweekly" | "monthly"
  cancelledAt    DateTime?
  createdAt      DateTime @default(now())
  createdById    String

  club      Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team      Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  creator   User         @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: Cascade)
  rsvps     MeetingRsvp[]

  @@index([clubId, startTime])
}

model MeetingRsvp {
  id          String   @id @default(cuid())
  meetingId   String
  userId      String
  status      String   @default("maybe") // going | not_going | maybe
  respondedAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
}

// ---------------------------------------------------------------------------
// Notifications & Activity Log
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  clubId    String?
  type      String // hours_approved | hours_rejected | new_announcement | task_assigned | meeting_reminder | new_comment | new_reaction | promoted | demoted | new_member
  message   String
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club? @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model ActivityLog {
  id          String   @id @default(cuid())
  clubId      String
  actorUserId  String
  actionType  String
  targetType  String
  targetId    String?
  description String
  createdAt   DateTime @default(now())

  club   Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  actor  User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([clubId, createdAt])
}

// ---------------------------------------------------------------------------
// Group Chat — conversations, members, messages, reactions
// ---------------------------------------------------------------------------

model Conversation {
  id        String   @id @default(cuid())
  clubId    String
  type      String   // "club_wide" | "group" | "direct"
  name      String?  // group chat name; null for club_wide + direct
  createdBy  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club      Club                @relation(fields: [clubId], references: [id], onDelete: Cascade)
  members   ConversationMember[]
  messages  Message[]

  @@index([clubId, updatedAt])
}

model ConversationMember {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  role           String   @default("member") // "owner" for group chat creator, else "member"
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  authorId       String
  body           String
  createdAt      DateTime @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  pinnedAt       DateTime? // for pinned important messages

  conversation Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions    MessageReaction[]

  @@index([conversationId, createdAt])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId]) // one reaction per user per message (swap on change)
  @@index([messageId])
}


// ---------------------------------------------------------------------------
// Custom Badges — exec-created, manually awarded to members
// ---------------------------------------------------------------------------

model Badge {
  id          String   @id @default(cuid())
  clubId      String
  name        String
  description String?
  emoji       String   @default("🏆")
  createdAt   DateTime @default(now())
  createdBy   String

  club      Club       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  creator   User       @relation("BadgeCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  awards    MemberBadge[]

  @@index([clubId])
}

model MemberBadge {
  id          String   @id @default(cuid())
  badgeId     String
  userId      String
  clubId      String
  awardedBy   String
  awardedAt   DateTime @default(now())

  badge    Badge     @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  club     Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  awarder  User      @relation("BadgeAwarder", fields: [awardedBy], references: [id], onDelete: Cascade)

  @@unique([badgeId, userId])
  @@index([clubId, userId])
}

// ───────────────────────────────────────────────────────────────────────────
// Financials — club budget / revenue / expense tracking.
//   type: "revenue" (money in) | "expense" (money out)
//   category: free-text (e.g. "Bake sale", "Supplies", "Transportation")
//   amount: always positive; revenue adds to balance, expense subtracts.
//   createdBy: the executive who recorded it.
// ───────────────────────────────────────────────────────────────────────────
model ClubTransaction {
  id          String   @id @default(cuid())
  clubId      String
  type        String   // "revenue" | "expense"
  amount      Float
  category    String
  description String?
  date        DateTime @default(now())
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  club      Club       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  creator   User?      @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([clubId, date])
}

// ───────────────────────────────────────────────────────────────────────────
// Notes — member-authored markdown notes (storage-constrained, no images).
//   title:       optional, API max 120 chars
//   content:     markdown body, API max 5000 chars
//   isPrivate:   if true, only author + sharedWith user IDs can see it
//   sharedWith:  JSON array of userIds; null/empty = treated as private-with-no-shares
//   deletedAt:   soft-delete timestamp; non-null = invisible everywhere
//   Caps (API-enforced, per club): 500 notes, 50 tags
//
// Design note: schema stays SQLite-portable (no @db.* native types). The
// length caps above are enforced at the API layer. Production Postgres
// deployment uses the same schema (provider flips via Dockerfile sed).
// ───────────────────────────────────────────────────────────────────────────
model ClubNote {
  id          String   @id @default(cuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String?  // API max 120 chars (no @db type — SQLite-portable)
  content     String   // API max 5000 chars
  isPrivate   Boolean  @default(false)
  // JSON array of userIds; null/empty when public. Resolved at read time.
  sharedWith  Json?
  hearts      NoteHeart[]
  tags        NoteTagAssignment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([clubId, deletedAt, createdAt])
  @@index([authorId])
}

model NoteTag {
  id          String   @id @default(cuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name        String   // API max 40 chars (no @db type — SQLite-portable)
  color       String?  // hex color, optional, API max 7 chars
  // Plain createdBy userId (no relation back to User — we don't navigate by
  // creator anywhere, and the simpler shape avoids another back-relation).
  createdBy   String
  createdAt   DateTime @default(now())
  assignments NoteTagAssignment[]

  @@unique([clubId, name])
  @@index([clubId])
}

model NoteTagAssignment {
  noteId      String
  note        ClubNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tagId       String
  tag         NoteTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  assignedAt  DateTime @default(now())

  @@id([noteId, tagId])
  @@index([tagId])
}

model NoteHeart {
  id        String   @id @default(cuid())
  noteId    String
  note      ClubNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([noteId, userId])
  @@index([noteId])
}
